            electron_maxstep = 500,
                 startingwfc = 'atomic+random',
                 mixing_mode = 'local-TF',
                 mixing_beta = 0.2D0,
                    conv_thr = 1.0D-7
/
&IONS
                ion_dynamics = 'bfgs',
/
&CELL
               cell_dynamics = 'bfgs',
                 cell_factor = 1.0,
                       press = 0.0
/
