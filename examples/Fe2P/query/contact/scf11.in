&CONTROL
                 calculation = 'scf',
                restart_mode = 'from_scratch',
                      prefix = 'fe2p_scff2.r3',
                  pseudo_dir = '/marconi/home/userexternal/misah000/pseudo/',
                      outdir = '/marconi_scratch/userexternal/misah000/scf/',
                   verbosity = 'high',
                     tstress = .true.,
                     tprnfor = .true.
/
&SYSTEM
                       ibrav = 0,
                         nat = 109,
                        ntyp = 3,
                     ecutwfc = 80,
                     ecutrho = 800,
                       nspin = 2,
   starting_magnetization(1) = 0.5,
