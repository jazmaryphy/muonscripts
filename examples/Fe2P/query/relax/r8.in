&CONTROL
                 calculation = 'relax',
                restart_mode = 'from_scratch',
                      prefix = 'fe2p_hexk.r8',
                  pseudo_dir = '/home/vol05/scarf795/pseudo/',
                      outdir = '/scratch/jaz/',
                   verbosity = 'high',
                     tstress = .true.,
                     tprnfor = .true.
/
&SYSTEM
                       ibrav = 0,
                         nat = 109,
                        ntyp = 3,
                     ecutwfc = 80,
                     ecutrho = 800,
                       nspin = 2,
   starting_magnetization(1) = 0.5,
                 occupations = 'smearing',
                    smearing = 'gaussian',
                     degauss = 0.02,
/
&ELECTRONS
             diagonalization = 'david'
            electron_maxstep = 200,
                 startingwfc = 'atomic+random',
                 mixing_mode = 'local-TF',
                 mixing_beta = 0.2D0,
                    conv_thr = 1.0D-7
/
&IONS
                ion_dynamics = 'bfgs',
/
&CELL
               cell_dynamics = 'bfgs',
                 cell_factor = 1.0,
                       press = 0.0
/
