&CONTROL
                 calculation = 'scf'
                   verbosity = 'high'
                restart_mode = 'from_scratch'
                  wf_collect = .true.
                       nstep = 300
                     tstress = .true.
                     tprnfor = .true.
                      outdir = './'
                      prefix = 'scf_0.178_CoF2_nspin2'
                 max_seconds = 604800
               etot_conv_thr = 0.0001
               forc_conv_thr = 0.001
                  pseudo_dir = './'
/

&SYSTEM
                     ecutwfc = 60.0
                     ecutrho = 600.0
                 occupations = 'smearing'
                     degauss = 0.01
                    smearing = 'gaussian'
                       nspin = 2
   starting_magnetization(1) = 0.5
   starting_magnetization(2) = -0.5
   starting_magnetization(3) = 0.0
                        ntyp = 3
                         nat = 6
                       ibrav = 0
/

&ELECTRONS
            electron_maxstep = 800
                    conv_thr = 1e-07
                 mixing_mode = 'local-TF'
                 mixing_beta = 0.3
/

