&CONTROL
        calculation = 'scf'
          verbosity = 'high'
       restart_mode = 'from_scratch'
         wf_collect = .true.
              nstep = 300
            tstress = .true.
            tprnfor = .true.
             outdir = './'
             prefix = 'scf_0.271_Tb2MnNiO6_nspin1'
        max_seconds = 604800
      etot_conv_thr = 0.0001
      forc_conv_thr = 0.001
         pseudo_dir = './'
/

&SYSTEM
            ecutwfc = 60.0
            ecutrho = 600.0
        occupations = 'smearing'
            degauss = 0.01
           smearing = 'gaussian'
               ntyp = 3
                nat = 8
              ibrav = 0
/

&ELECTRONS
   electron_maxstep = 800
           conv_thr = 1e-07
        mixing_mode = 'local-TF'
        mixing_beta = 0.3
/

ATOMIC_SPECIES
Tb  158.92535  Tb.pbe-spn-kjpaw_psl.1.0.0.UPF
Mn  54.938044  Mn.pbe-spn-kjpaw_psl.1.0.0.UPF
Ni    58.6934  Ni.pbe-spn-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
4  4  4  0  0  0

