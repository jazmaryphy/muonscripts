&CONTROL
        calculation = 'relax'
          verbosity = 'high'
       restart_mode = 'from_scratch'
         wf_collect = .true.
              nstep = 300
            tstress = .true.
            tprnfor = .true.
             outdir = '/scratch/jaz/ucoge'
             prefix = 'UCG_mun0_7'
        max_seconds = 604800
      etot_conv_thr = 0.0001
      forc_conv_thr = 0.001
         pseudo_dir = '/home/vol05/scarf795/pseudo/GBRV'
/

&SYSTEM
         tot_charge = 0.0
            ecutwfc = 60.0
            ecutrho = 600.0
        occupations = 'smearing'
            degauss = 0.005
           smearing = 'gaussian'
               ntyp = 4
                nat = 145
              ibrav = 0
/

&ELECTRONS
   electron_maxstep = 800
           conv_thr = 1e-07
        mixing_mode = 'local-TF'
        mixing_beta = 0.3
/

&IONS
       ion_dynamics = 'bfgs'
/

&CELL
      cell_dynamics = 'bfgs'
              press = 0.0
        cell_factor = 1.0
/

