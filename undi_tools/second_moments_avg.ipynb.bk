   "source": [
    "_convert_atomic_cutoff_keys_to_atomic_numbers(\n",
    "    {\"F\": 4.0, \"Ca\": 6.0}\n",
    ")\n",
    "\n",
    "import os\n",
    "from io_tools.read import read_cif\n",
    "dpath='/home/misah/projects/scripts/DATA'\n",
    "filename = os.path.join(dpath, 'CaF2_1559793.cif')\n",
    "\n",
    "atoms = read_cif(filename)\n",
    "\n",
    "cutoff ={'F': 3, 'Ca': 0.0}\n",
    "\n",
    "muon_position = [0, 1.0/4, 0]\n",
    "muon_position = [0.25, 0.25, 0.5]\n",
    "\n",
    "contribs = second_moments(atoms, muon_position=muon_position, cutoff=cutoff)\n",
    "\n",
    "sigma2_tot = sum(contribs.values())\n",
    "contribs, sigma2_tot\n",
    "print(\"=== CaF2 self-test (undistorted lattice, muon at 1/4,1/4,1/2) ===\")\n",
    "_pretty_print(contribs, sigma2_tot)\n",
    "\n",
    "\n",
    "# add muon\n",
    "atoms_mu = _add_muon(atoms, muon_position)\n",
    "\n",
    "# cross-check against the paper's dimensionless lattice sum,\n",
    "# Sigma_infinity = sum_j (a/4)^6 / r_j^6 = 2.0908748  (Eq. 5, SI)\n",
    "d = neighbor_list('d', atoms_mu, cutoff={('H', 'F'): 40})  # , ('H', 'Ca'): 40\n",
    "Sigma_inf = 0.5 * np.sum(d ** -6) * (5.451 / 4) ** 6\n",
    "print(f\"\\nSigma_infinity (F only) = {Sigma_inf:.7f}  \"\n",
    "    f\"(paper quotes 2.0908748)\")\n",
    "\n",
    "\n",
    "# ---- zeta: reproduce the paper's zeta = 0.943 for undistorted CaF2 ----\n",
    "# nn shell:  2 F at a/4  = 1.36275 A   -> r_nn_max just above that\n",
    "# nnn shell: 8 F at (a/4)*sqrt(5) = 3.04720 A -> r_nnn_max just above that\n",
    "zeta, diag = compute_zeta_shell_sum(atoms_mu, r_nn_max=1.4, r_nnn_max=3.1, r_inf=40.0)\n",
    "print(f\"\\nzeta = {zeta:.4f}  (paper quotes 0.943 for the undistorted lattice)\")\n",
    "print(f\"  S2_nn={diag['S_nn']:.6g}  S2_nnn={diag['S_nnn']:.6g}  S2_inf={diag['S_inf']:.6g}\")"
   ]
